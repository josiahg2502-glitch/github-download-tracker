{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Downloads",
  "version": "1.0.0",
  "identifier": "io.github.josiahg2502-glitch.downloads",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GitHub Downloads",
        "width": 1120,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "josiahg2502-glitch",
    "shortDescription": "Lifetime GitHub release download tracker",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
